# Single source of truth for pinned runtime versions (read by docker compose via --env-file
# and verified by `python tasks.py verify-lock`). Contains no secrets. Images are pinned by
# tag AND digest. Resolved 2026-09-25 from Docker Hub / Maven Central / PyPI.

# Base and service images (multi-arch index digests)
KAFKA_IMAGE=apache/kafka:4.3.1@sha256:77e3df9054047a88b520d0cc46e16696d3b22022e1d580aeccd2632df6532837
SPARK_BASE_IMAGE=spark:4.1.3-scala2.13-java17-python3-ubuntu@sha256:b4fe2efb05df81a8a3a9cb28664da662a3b4f418bfc091ed3636857786af5949
FLINK_BASE_IMAGE=flink:2.2.1-java17@sha256:13b1328bbb86263b41e740f06790f49c8512a26a5c0eba36a8f91b1983d33a6c
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.8.10@sha256:8a1589a2dd9aca97f5ef61740ac9e29c98193e2ae6a868e9c4808d3d4f11fa5e

# Spark 4.1 line: Delta publishes a Spark-4.1-specific artifact; Kafka source matches Spark.
SPARK_VERSION=4.1.3
DELTA_VERSION=4.4.0
DELTA_SPARK_ARTIFACT=io.delta:delta-spark_4.1_2.13
SPARK_KAFKA_ARTIFACT=org.apache.spark:spark-sql-kafka-0-10_2.13
SPARK_PROTOBUF_ARTIFACT=org.apache.spark:spark-protobuf_2.13

# Flink 2.2 line: newest Flink with a released Kafka connector (none yet for 2.3).
PYFLINK_VERSION=2.2.1
FLINK_KAFKA_CONNECTOR_VERSION=5.0.0-2.2
# zstd codec for that connector (its kafka-clients 4.2.0 declares zstd-jni at runtime but the
# SQL connector jar does not bundle it; the replayed topics are zstd-compressed).
ZSTD_JNI_VERSION=1.5.6-10
