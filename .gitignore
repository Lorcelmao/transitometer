# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
build/
dist/

# Local configuration and secrets (config/.env.example is the committed template)
config/.env
.env
*.env.local

# Bulk data never lives in Git: the host zone is D:\Transitometer-data (PROJECT_PLAN.md §1.3).
# Anchored to the repo root so package names like src/transitometer/golden/ stay tracked.
# Committed results (result CSVs, golden checksums) belong in results/ and golden/ (§19).
/data/
/landing/
/exports/
*.parquet
*.pb
*.zip
*.pbf
*.vhdx
# Small deterministic test fixtures are the exception.
!/tests/fixtures/**
# The frozen golden reference: small table copies and query answers (the large tables stay in the
# data folder; every checksum is in golden/checksums.json).
!/golden/tables/*.parquet
!/golden/queries/*.parquet
# Full error output of container runs (the JSON reports next to them are committed).
/results/*.stderr.log
# Reports of runs on scratch topic prefixes (demo, trials).
/results/scratch/

# Local agent/review working notes (not project deliverables)
plans/reports/

# Editors / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
