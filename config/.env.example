# Host-specific settings. Copy to config/.env (git-ignored) and adjust. No secrets belong here.

# Host zone (PROJECT_PLAN.md §1.3): landing/, golden/, results/, exports/ live under this root.
TRANSITOMETER_DATA_ROOT=D:/Transitometer-data

# Docker Desktop disk image, measured by the storage guard (leave empty if unknown).
TRANSITOMETER_DOCKER_VHDX=D:/DockerDesktop/DockerDesktopWSL/disk/docker_data.vhdx

# Soft storage guard thresholds for Docker's logical usage, in GB.
TRANSITOMETER_STORAGE_WARN_GB=25
TRANSITOMETER_STORAGE_BLOCK_GB=30
